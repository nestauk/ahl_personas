# OpenAI API key — required for LLM calls
OPENAI_API_KEY=your-api-key-here

# Optional: shared API key for backend auth. When unset, auth is disabled (local dev default).
# API_KEY=your-secret-key

# Optional: comma-separated CORS origins (defaults to http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000

# Optional: evidence and vector store paths (defaults to ./data/...)
# QDRANT_PATH=./data/qdrant_store
# EVIDENCE_CSV_PATH=./data/evidence_base.csv
# SOURCES_DIR=./data/sources

# Optional: override the default model (global fallback for all tasks).
# GPT-6 family: gpt-6-sol (default; reasoning none..max), gpt-6.1-sol (more tokens, no "none")
# OPENAI_MODEL=gpt-6-sol

# Optional: per-task model overrides. Each defaults to OPENAI_MODEL if not set.
# OPENAI_SCAN_MODEL=gpt-6-sol      # Population relevance scan + sub-group composition
# OPENAI_ANALYSIS_MODEL=gpt-6-sol  # Per-sub-group analysis + synthesis
# OPENAI_SOCRATIC_MODEL=gpt-6-sol  # Socratic policy specification conversation
# OPENAI_CHAT_MODEL=gpt-6-sol      # Follow-up chat grounded in the reports

# Optional: per-task reasoning effort. Values: none, low, medium, high, xhigh, max.
# Set to an empty value to use the model's default.
# OPENAI_SCAN_REASONING_EFFORT=low
# OPENAI_ANALYSIS_REASONING_EFFORT=low       # Per-sub-group analysis
# OPENAI_SYNTHESIS_REASONING_EFFORT=medium   # Cross-group equity synthesis
# OPENAI_SOCRATIC_REASONING_EFFORT=low
# OPENAI_CHAT_REASONING_EFFORT=low

# Optional: how many sub-group analyses run in parallel (lower if you hit 429 rate limits).
# SUBGROUP_CONCURRENCY=6

# Optional: Langfuse tracing — traces every LLM call when set. Omit to disable.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
