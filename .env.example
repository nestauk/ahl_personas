# OpenAI API key — required for LLM calls
OPENAI_API_KEY=your-api-key-here

# Optional: shared API key for backend auth. When unset, auth is disabled (local dev default).
# API_KEY=your-secret-key

# Optional: comma-separated CORS origins (defaults to http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000

# Optional: evidence and vector store paths (defaults to ./data/...)
# QDRANT_PATH=./data/qdrant_store
# EVIDENCE_CSV_PATH=./data/evidence_base.csv
# SOURCES_DIR=./data/sources

# Optional: override the default model (global fallback for all tasks).
# GPT-5.6 family: gpt-5.6-sol (flagship), gpt-5.6-terra (balanced), gpt-5.6-luna (fast/cheap)
# OPENAI_MODEL=gpt-5.6-terra

# Optional: per-task model overrides. Each defaults to OPENAI_MODEL if not set.
# OPENAI_SCAN_MODEL=gpt-5.6-terra      # Population relevance scan + sub-group composition
# OPENAI_ANALYSIS_MODEL=gpt-5.6-sol    # Per-sub-group analysis + synthesis (deep reasoning)
# OPENAI_SOCRATIC_MODEL=gpt-5.6-terra  # Socratic policy specification conversation
# OPENAI_CHAT_MODEL=gpt-5.6-terra      # Follow-up evidence-grounded chat

# Optional: per-task reasoning effort. Values: minimal, low, medium, high.
# Omit to use the model's default (medium for GPT-5).
# OPENAI_SCAN_REASONING_EFFORT=low         # Classification doesn't need deep reasoning
# OPENAI_ANALYSIS_REASONING_EFFORT=medium  # Core analytical depth — keep at medium or high
# OPENAI_SOCRATIC_REASONING_EFFORT=low     # Conversational questioning — low reduces TTFT
# OPENAI_CHAT_REASONING_EFFORT=low         # Follow-up Q&A — low is usually sufficient

# Optional: Langfuse tracing — traces every LLM call when set. Omit to disable.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
